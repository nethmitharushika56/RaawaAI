# Repository .gitignore for RaawaAI (repo root)

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
ENV/
env/

# pipenv / poetry
Pipfile.lock
poetry.lock

# pyenv
.python-version

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Logs and databases
*.log
logs/
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment variables / secrets
# Ignore runtime environment files at every project level.
**/.env
**/.env.*
**/.env.example
secrets/
*.secret
*.secrets
credentials.json
credentials.local.json
*.pem
*.key

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / frontend build
dist/
.vite

# Frontend SSR
dist-ssr/

# Editor and OS files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Coverage
.coverage
htmlcov/

# Local tests (kept out of the GitHub repository by project request)
**/tests/
**/test_*.py
**/*_test.py

# Generated by tooling
.pytest_cache/
coverage.xml

# Local VS Code workspace storage
.history/

# Antigravity IDE / Agentic Coding
implementation_plan.md
task.md
walkthrough.md
